{
  "name": "click-to-agent",
  "version": "0.0.1",
  "description": "Alt+Click any React component to jump to source (Cursor, VS Code) or send props, state & DOM to AI agents. Works with Next.js, Vite, TanStack Start & Rsbuild — no browser extension.",
  "keywords": [
    "react",
    "react-19",
    "nextjs",
    "vite",
    "tanstack",
    "rsbuild",
    "rspack",
    "developer-tools",
    "devtools",
    "source-locator",
    "click-to-component",
    "click-to-source",
    "click-to-agent",
    "ai-agent",
    "cursor",
    "claude-code",
    "vscode",
    "source-map",
    "locator",
    "turbopack"
  ],
  "author": "stekovinbranturry <zhangkai-zk@foxmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stekovinbranturry/click-to-agent"
  },
  "homepage": "https://github.com/stekovinbranturry/click-to-agent#readme",
  "bugs": {
    "url": "https://github.com/stekovinbranturry/click-to-agent/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "echo \"(no tests yet)\" && exit 0",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/node": "^25.2.2",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@11.5.2"
}
