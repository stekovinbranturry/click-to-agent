{
  "name": "click-to-agent",
  "version": "0.1.0",
  "description": "Alt/Option+Click any React component to open its source — or send it to your AI coding agent (Cursor / Claude Code) with full context. Zero-config for Next.js + Turbopack + React 19.",
  "keywords": [
    "react",
    "nextjs",
    "developer-tools",
    "source-locator",
    "ai",
    "agent",
    "cursor",
    "claude-code",
    "vscode",
    "devtools",
    "click-to-component",
    "turbopack",
    "react-devtools"
  ],
  "author": "stekovinbranturry <zhangkai-zk@foxmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stekovinbranturry/click-to-agent"
  },
  "homepage": "https://github.com/stekovinbranturry/click-to-agent#readme",
  "bugs": {
    "url": "https://github.com/stekovinbranturry/click-to-agent/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
